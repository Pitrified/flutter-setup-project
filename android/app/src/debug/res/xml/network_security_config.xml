<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Permits cleartext HTTP to the mock OpenAI server
  (tool/mock_openai.py), reached at 10.0.2.2 from an emulator or at 127.0.0.1
  when adb reverse is in play. Every other destination keeps the platform
  default, which is HTTPS only, and release builds never see this file.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
